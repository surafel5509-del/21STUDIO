MISTRAL_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# Free-tier friendly defaults used by 21STUDIO.
MISTRAL_MODEL=mistral-small-latest
GROQ_MODEL=openai/gpt-oss-20b
CEREBRAS_MODEL=gpt-oss-120b

DEFAULT_PROVIDER=auto
# Keep fallback providers in this order when a configured provider fails.
PROVIDER_ORDER=cerebras,groq,mistral

# Optional persistent memory database path. Defaults to backend/data/memory.db
MEMORY_DB_PATH=
FRONTEND_URL=http://localhost:3000
